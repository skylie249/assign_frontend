# Vercel 프로젝트 설정 > Environment Variables 에 등록 (값은 여기에 적지 말 것)

# 사내 API가 노출되는 터널 주소 (weekreport_frontend와 같은 Cloudflare Tunnel, /api/assign/* 추가됨)
BACKEND_API_ORIGIN=https://weekreport-api.nexalab.app

# API 앞단에 Cloudflare Access를 걸 경우에만 필요 (2026-11-20 기준 아직 안 걸려 있음)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
